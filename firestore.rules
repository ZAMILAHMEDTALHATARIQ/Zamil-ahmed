rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    function isTimestamp(val) { return val is timestamp; }
    function isString(val, maxLen) { return val is string && val.size() <= maxLen; }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'createdAt'])
        && data.keys().size() >= 2
        && data.keys().size() <= 3
        && isString(data.email, 254)
        && isTimestamp(data.createdAt)
        && (!('name' in data) || isString(data.name, 100));
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() 
        && request.auth.uid == userId
        && isValidId(userId)
        && isValidUser(incoming())
        && incoming().createdAt == request.time;
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && isValidId(userId)
        && isValidUser(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['name']);
      allow delete: if false;
    }

    function isValidFavorite(data) {
      return data.keys().hasAll(['userId', 'itemId', 'itemType', 'createdAt'])
        && data.keys().size() == 4
        && isString(data.userId, 128)
        && isString(data.itemId, 100)
        && isString(data.itemType, 50)
        && (data.itemType == 'BURGER' || data.itemType == 'BROAST' || data.itemType == 'DEAL')
        && isTimestamp(data.createdAt);
    }

    match /favorites/{favoriteId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(favoriteId)
        && isValidFavorite(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
